{
  "name": "Varnum",
  "short_name": "Varnum",
  "description": "Write in English and get your letter in Hindi or 20+ languages as you type. Open and edit Excel, Word, PowerPoint and PDF files.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f7f9",
  "theme_color": "#f6f7f9",
  "icons": [
    {
      "src": "icon-192.png?v=26",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png?v=26",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png?v=26",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./#excel",
      "accept": {
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ],
        "application/vnd.ms-excel": [
          ".xls"
        ],
        "text/csv": [
          ".csv"
        ]
      }
    }
  ]
}
